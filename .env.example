# Copy this file to ".env" and fill in real values. Never commit ".env".

PORT=3000
NODE_ENV=development

# Sign this with a long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_HOURS=8

# --- Support ticket delivery -------------------------------------------------
# The destination inbox lives here on the server only. It is never sent to the
# browser and never appears in any API response.
TICKET_INBOX=gammahyphen@gmail.com

# SMTP credentials used to send the ticket mail.
# For Gmail, create an App Password (Google Account > Security > App passwords)
# and use it as SMTP_PASS. Your normal Gmail password will not work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="E-Voting Support" <your-sending-account@gmail.com>

# Set to true to skip real SMTP and write the email to the console + /outbox.
# Useful while developing before SMTP is configured.
MAIL_DRY_RUN=true

# --- Supabase ----------------------------------------------------------------
# Project: gammahyphen@gmail.com's Project (ref bgscnhrdmipgetbkksmd)
# Tables:  public.votes, public.tickets
#          schema kept in supabase/migrations/
SUPABASE_URL=https://bgscnhrdmipgetbkksmd.supabase.co

# The SERVICE ROLE key, not the anon/publishable one. Both tables have row
# level security enabled with no policies, so the anon key reads nothing at
# all -- that is deliberate. Only the service role can read or write them,
# which is why this value must stay on the server.
#
# Supabase dashboard > Project Settings > API Keys > the key marked "secret".
# Current projects issue "sb_secret_..."; older ones issue a "service_role"
# JWT beginning "eyJ". Both work. Check yours with: npm run check-supabase
#
# NEVER paste this key into a chat, a screenshot, a commit or any file other
# than .env. It bypasses row level security completely: anyone holding it can
# read every ballot and every complainant's contact details. If it is ever
# exposed, rotate it in the dashboard immediately.
SUPABASE_SERVICE_ROLE_KEY=

# Leave false until the key above is filled in. When false the portal keeps
# using the JSON file store on its own and never contacts Supabase.
SUPABASE_ENABLED=false

# --- Face verification -------------------------------------------------------
# Maximum distance between the live face and the enrolled one that still counts
# as a match. Lower is stricter. face-api.js descriptors sit near 0.6 for the
# same person; 0.5 trades the odd retry for fewer wrong-person matches.
FACE_MATCH_THRESHOLD=0.5

# "enrolled" challenges only voters who have a face on file, so the roll stays
# usable while people are enrolled one at a time.
# "all" refuses a card or a ballot to anybody who has not enrolled.
FACE_ENFORCE=enrolled

# Seconds a passed face check stays valid. It is spent within seconds of being
# issued, so this only needs to cover a slow request.
FACE_TOKEN_TTL=300

# --- Detector tuning ---------------------------------------------------------
# These were picked by timing the detector over the six sample faces that ship
# with the library. Raise or lower them here; no code change is needed, the
# browser reads them from the server.

# Frame size the detector works at: 128, 160, 224, 320, 416, 512 or 608.
# Smaller is faster. 320 found a face in all six samples at roughly half the
# cost of 416, which was no more accurate.
FACE_INPUT_SIZE=320

# How sure the detector must be that it is looking at a face, 0.05 to 0.9.
# Lower if it keeps saying "no face found" -- a headscarf, glasses or dim
# indoor light all push the score down. A loose detection costs nothing,
# because the descriptor comparison is the real check.
FACE_SCORE_THRESHOLD=0.3

# Consecutive single-face reads before the measurement is taken, 1 to 10.
# Lower is quicker but more willing to read a blurred frame. The measuring
# pass re-checks the face count itself, so two is enough.
FACE_STABLE_SAMPLES=2

# How long to keep looking before giving up, in milliseconds.
FACE_CAPTURE_TIMEOUT=20000
